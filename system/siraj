#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

ROOT="${HOME}/siraj"
SYS="${ROOT}/system"
LOGDIR="${ROOT}/logs"
mkdir -p "$LOGDIR"
ORCH="${SYS}/siraj_orchestrator.sh"
LOG="${LOGDIR}/siraj_cmd.log"

log(){ printf "[%s] %s\n" "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG"; }

cmd="${1:-status}"

case "$cmd" in
  start)
    log "⚙️ Starting all Siraj services..."
    bash "$ORCH" start_all
    ;;
  stop)
    log "🛑 Stopping all Siraj services..."
    bash "$ORCH" shutdown_siraj
    ;;
  restart)
    log "🔄 Restarting all Siraj services..."
    bash "$ORCH" shutdown_siraj
    sleep 2
    bash "$ORCH" start_all
    ;;
  clean)
    log "🧹 Cleaning old logs & freeing memory..."
    find "$LOGDIR" -type f -mtime +2 -delete 2>/dev/null || true
    log "✅ Logs older than 2 days removed."
    ;;
  status)
    log "📊 Siraj status check:"
    ps -ef | grep siraj_ | grep -v grep || log "No active Siraj processes."
    ;;
  *)
    echo "Usage: siraj {start|stop|restart|status|clean}"
    exit 1
    ;;
esac
